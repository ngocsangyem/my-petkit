# Copy to `.env` (git ignores it) and fill in. Read by docker-compose.yml.

# Required. The address the DEVICE calls: this machine's LAN IP and port 80,
# with the API prefix. Not a `.local` name: embedded devices cannot resolve
# mDNS.
MY_PETKIT_API_URL=http://192.168.1.20/6/

# Your Home Assistant MQTT broker (IP or host name). Empty runs without
# Home Assistant.
MY_PETKIT_HA_MQTT_HOST=

# IANA zone for local time, e.g. Asia/Ho_Chi_Minh. Days, feed schedules and
# the time sent to devices are read in it.
MY_PETKIT_TIMEZONE=UTC

# Host names browsers may use for the dashboard, comma-separated, e.g. the name
# of a reverse proxy. IP addresses and localhost are always allowed.
MY_PETKIT_USER_HOSTS=

# WebRTC: host:port addresses a viewer reaches this machine's 8555 on,
# comma-separated, e.g. 192.168.1.20:8555. Empty offers MSE and HLS only.
MY_PETKIT_WEBRTC_CANDIDATES=

# Image tag: latest, a release such as 0.0.1, or dev.
MY_PETKIT_TAG=latest
