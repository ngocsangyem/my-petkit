# /etc/wireguard/wg0.conf on the VPS. Generate the keys ON EACH MACHINE:
#   umask 077; wg genkey | tee private.key | wg pubkey > public.key
# and never copy a private key off the machine that made it.

[Interface]
# The VPS's tunnel address: MY_PETKIT_WG_ADDRESS in .env, and the address
# devices are told to call.
Address = 10.66.0.1/24
ListenPort = 51820
PrivateKey = <VPS private key>
# Below the 1500-byte path every home connection has, with WireGuard's 80-byte
# overhead taken off; PPPoE lines may need 1412.
MTU = 1420

# Clamp TCP MSS on everything forwarded into the tunnel (the container's
# connections to devices are forwarded, not local). Without it a device that
# sends a full-size segment stalls the transfer: the classic symptom is a small
# request that works and a video upload that hangs.
PostUp = iptables -t mangle -A FORWARD -o %i -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
PostDown = iptables -t mangle -D FORWARD -o %i -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu

[Peer]
# The home router.
PublicKey = <home router public key>
# Its tunnel address and the subnet the devices live on. Traffic for the
# devices is ROUTED here, unchanged: the server must see each device's own
# address, because that is the only address it will ever dial back
# (utils/outbound_guard.py).
AllowedIPs = 10.66.0.2/32, 192.168.1.0/24
