# Copy to `.env` (git ignores it) and fill in. Read by docker-compose.yml.

# The public name of the dashboard. Its DNS A record points at
# MY_PETKIT_PUBLIC_ADDRESS; Caddy gets its certificate for it. Do NOT add an
# AAAA record: nothing here listens on IPv6, so Let's Encrypt (which tries
# IPv6 first) fails to issue and IPv6-first phones cannot connect.
MY_PETKIT_DOMAIN=petkit.example.com

# The VPS's public IPv4 address. WebRTC tells viewers to connect to it, and
# Caddy and WebRTC bind it.
MY_PETKIT_PUBLIC_ADDRESS=203.0.113.10

# Only on a cloud that maps the public address by NAT (AWS, GCP, Azure,
# Oracle): there it is on no interface and cannot be bound, so bind the
# instance's private address instead (`ip -4 addr`). Leave empty elsewhere.
MY_PETKIT_PUBLIC_BIND=

# The VPS's address on wg0 (the `Address` in wireguard/wg0.conf). Devices are
# told to call this.
MY_PETKIT_WG_ADDRESS=10.66.0.1

# IANA zone for local time, e.g. Asia/Ho_Chi_Minh.
MY_PETKIT_TIMEZONE=UTC

# Only when the home subnet is not a private range: comma-separated CIDRs.
MY_PETKIT_EXTRA_DEVICE_SUBNETS=

# A Home Assistant MQTT broker reachable from the VPS (over the tunnel), or
# empty to run without Home Assistant. The router must also forward tcp 1883
# from 10.66.0.1 to that host (wireguard/home-router.conf.example).
MY_PETKIT_HA_MQTT_HOST=

# Image tag: latest, a release such as 0.0.1, or dev.
MY_PETKIT_TAG=latest
