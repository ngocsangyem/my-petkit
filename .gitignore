__pycache__/
*.pyc
.DS_Store

# Runtime data, at ANY depth — NOT `/data/`, which is root-anchored and so
# missed `addon/data/`, the exact path the README tells you to create
# (`cd addon` … `--data-dir ./data`). What lives in there: the TLS
# private key (`certs/broker.key`), the real PetKit/Aliyun credentials proxy
# mode collects (`proxy_upstream.json`), per-device signing secrets
# (`devices.json`), the media AES key, raw traffic captures, pet photos and
# video. One `git add -A` after a dev session used to publish all of it.
data/

# Belt and braces for the same material, wherever it is written.
*.jsonl
*.log
*.key
*.pem
*.crt
.env

# Local virtualenv / build artifacts
.venv/
venv/
*.egg-info/
build/
dist/
# uv lockfile from a local `uv` run; the project pins via pyproject, not a lockfile
uv.lock

# Test/tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# SQLite event store (created at runtime, incl. WAL sidecars)
*.db
*.db-wal
*.db-shm

# Machine-specific Claude Code state (LAN addresses/paths, local scheduling)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Real device firmware images for patcher integration tests (multi-MB ELF blobs).
# Run `pytest --firmware` after populating addon/tests/firmware/ — see the test file.
addon/tests/firmware/

# ---- my-petkit additions (monorepo) ----
# Web client: dependencies, build output, local env files
node_modules/
apps/web/dist/
apps/web/.env*

# iOS: per-developer build output and signing (Team ID lives in *.local.xcconfig)
DerivedData/
*.xcuserstate
apps/ios/**/*.local.xcconfig

# Vendor firmware blobs for patcher tests, at their new location
services/api/tests/firmware/

# Real PetKit/Aliyun cloud credentials collected by proxy mode
**/proxy_upstream.json

# Raw traffic captures (verbatim payloads, they contain secrets)
captures/

# User-plane auth store (password hashes, session keys)
**/auth.db

# Mockup-only photos (CC BY-SA), never shipped
docs/design/assets/

# Working plans and agent reports live beside the source plan, not in the repo
plans/

# Swift Package Manager build output and per-user Xcode state
.build/
.swiftpm/
xcuserdata/

# XcodeGen output (regenerate with `xcodegen generate` in apps/ios)
apps/ios/MyPetkit.xcodeproj/

# Docs site (apps/docs): Next.js build caches, static export, generated MDX index
apps/docs/.next/
apps/docs/out/
apps/docs/.source/
apps/docs/next-env.d.ts
