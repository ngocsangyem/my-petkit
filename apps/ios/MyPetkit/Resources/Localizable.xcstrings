      }
    },
    "The pairing could not be saved to the Keychain; it lasts until the app quits." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không lưu được thông tin ghép nối vào Keychain; nó chỉ còn hiệu lực đến khi thoát ứng dụng."
          }
        }
      }
    },
    "The parent did not take the command. Nothing was sent. (%@)" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thiết bị mẹ không nhận lệnh. Chưa có gì được gửi. (%@)"
