      }
    },
    "The photo could not be loaded from the library." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không tải được ảnh từ thư viện."
          }
        }
      }
    },
    "The report interval is a whole number of seconds above 0." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
